#
# BEGIN Iam objects
#
objectclass ( 1.3.6.1.4.1.8389.1.2.1
  NAME 'IamUser'
  DESC 'Iam user class'
  SUP top
  AUXILIARY
  MAY ( isLocked $
        lockReason $
        lockDate $
        valid $
        failedLogins $
        failedTokenCounts $
        totalLogins $
        forcePasswordChange $
        failedLoginsBeforeLatestSuccessfulLogin $
        orderPassword $
        orderPasswordDate $
        orderPasswordUser $
        enabled $
        roles $
        memberOfGroup $
        latestPasswordChangeDate $
        nextEnforcedPasswordChangeDate $
        passwordGenerationDate $
        passwordDeliveryDate $
        authMethod $
        nextAuthMethod $
        authMigrationDate $
        notValidBefore $
        notValidAfter $
        latestLoginAttempt $
        latestSuccessfulLogin $
        secondLatestSuccessfulLogin $
        firstLogin $
        unlockAttempts $
        latestUnlockAttempt $
        matrixCardDeliveryDate $
        failedFirstFactorAttempts $
        secretQuestionsEnabled $
        tokenList $
        newTokenList $
        tokenListDeliDate $
        tokenListGenDate $
        tokenListOrdered $
        challengeOpenSince $
        unansweredChallenges $
        lastGsidValue $
        lastGsidDate $
        mtanTokenMobilePhone $
        mtanTokenActive $
        mtanTokenOrdered $
        mtanTokenGenerationDate $
        mtanTokenDeliverydate $
        selfRegisteredFlag $
        selfRegistrationDate $
        channelVerificationResends )
  X-ORIGIN 'http://confluence.ergon.ch/x/24HY' )
objectclass ( 1.3.6.1.4.1.8389.1.2.2
  NAME 'iamCredential'
  DESC 'Iam credential class'
  AUXILIARY
  MAY ( currentCredentialBinaryData $
        currentCredentialStringData $
        nextCredentialBinaryData $
        nextCredentialStringData $
        currentCredentialSerialNumber $
        nextCredentialSerialNumber $
        credentialActive $
        credentialOrdered $
        currentCredentialDeliveryDate $
        nextCredentialDeliveryDate $
        currentCredentialGenerationDate $
        nextCredentialGenerationDate $
        otherCredential1DeliveryDate $
        otherCredential2DeliveryDate )
  X-ORIGIN 'http://confluence.ergon.ch/x/24HY' )
objectclass ( 1.3.6.1.4.1.8389.1.2.3
  NAME 'iamPasswordSelfServiceToken'
  DESC 'Iam password self service token class'
  SUP top
  STRUCTURAL
  MUST ( pwdSelfServiceTokenId $
        uid )
  MAY ( pwdSelfServiceTokenIssuedAt $
        pwdSelfServiceTokenConsumed $
        pwdSelfServiceTokenConsumedAt $
        pwdSelfServiceFailedAttempts $
        enabled $
        givenName $
        sn )
  X-ORIGIN 'http://confluence.ergon.ch/x/24HY' )
objectclass ( 1.3.6.1.4.1.8389.1.2.4
  NAME 'iamGroup'
  DESC 'Iam user group'
  SUP groupOfNames
  STRUCTURAL
  MUST ( cn )
  MAY ( ou $
        memberOfGroup)
  X-ORIGIN 'http://confluence.ergon.ch/x/24HY' )

#
# END Iam objects
#
