{
  "description": "Airlock WAF Default Ingest Pipeline",
  "processors": [
	{
	  "set": {
		"field": "_index",
		"value": "airlock-gateway-default"
	  }
	},
	{
	  "date_index_name": {
		"field": "@timestamp",
		"date_formats": [
		  "ISO8601",
		  "yyyy-MM-dd'T'HH:mm:ss.SSSxx"
		],
		"index_name_prefix": "{{_index}}-",
		"date_rounding": "d",
		"index_name_format": "yyyy.MM.dd"
	  }
	},
	{
	  "json": {
		"description": "Parse custom log field to JSON",
		"field": "custom",
		"ignore_failure": true
	  }
	}
  ]
}
